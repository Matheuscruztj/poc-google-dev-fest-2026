EVENTOPS_MODE=offline
EVENTOPS_DATABASE=var/eventops.sqlite3
# Opcional: PostgreSQL já provisionado; migrations SQL versionadas rodam no startup.
# Em produção, veja docs/operacao-cloud.md sobre credencial DDL separada.
# Formato: postgresql://user:password@host:5432/eventops_app
# Configure a URL como segredo/variável protegida; não versione credenciais.
# EVENTOPS_DATABASE_URL=
EVENTOPS_SEED_CATALOG=true
EVENTOPS_HOST=127.0.0.1
EVENTOPS_PORT=8000
EVENTOPS_DEMO_USER=participante-demo
EVENTOPS_CONFIRMATION_TTL_SECONDS=300
EVENTOPS_COOKIE_SECURE=false
EVENTOPS_ALLOWED_ORIGINS=
EVENTOPS_AGENT_MODE=offline
EVENTOPS_AGENT_MODEL=gemini-2.5-flash
EVENTOPS_AGENT_TIMEOUT_SECONDS=12
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_PORT=11434
# RAG semântico local (opcional): ativar perfil rag e configurar URL interna do pgvector.
EVENTOPS_RAG_MODE=lexical
EVENTOPS_RAG_DATABASE_URL=
# No Cloud SQL gerenciado, a mesma instância usa eventops_app (dados operacionais)
# e eventops_rag (índice vetorial). No desenvolvimento local, EVENTOPS_DATABASE
# continua usando SQLite se EVENTOPS_DATABASE_URL não estiver definida.
EVENTOPS_EMBEDDING_PROVIDER=ollama
EVENTOPS_EMBEDDING_MODEL=
RAG_POSTGRES_PASSWORD=eventops-local-only
RAG_POSTGRES_PORT=55432
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Provider: offline (padrão), local (Ollama em Compose) ou live (Gemini API).
# Para EVENTOPS_AGENT_MODE=live, forneça GOOGLE_API_KEY no ambiente.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
